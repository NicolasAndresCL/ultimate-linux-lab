# Reduce el contexto de build y evita que nada indebido acabe en una capa.

# --- Trabajo del usuario y respaldos ---
workspace/
backups/

# --- Documentación: no entra en la imagen ---
*.md

# --- Control de versiones y CI ---
.git/
.gitignore
.gitattributes
.github/

# --- Secretos: nunca en una capa de la imagen ---
.env
.env.*
*.pem
*.key

# --- Editores y sistema operativo ---
.vscode/
.idea/
*.swp
*~
Thumbs.db
Desktop.ini
.DS_Store
